@baseUrl = http://localhost:5000/api/v1/employees
# @import ./variables.http

@employee01Id = 451533d5-d8d5-4a11-9c7b-eb9f14e1a32f
@employee02Id = f766e2bf-340a-46ea-bff3-f1700b435895

### GetEmployeesAsync - получение всех сотрудников
GET {{baseUrl}}

?? status == 200

>>! ./employeesViewResult.json

### GetEmployeeByIdAsync - получение сотрудника
GET {{baseUrl}}/{{employee01Id}}

?? status == 200

>> ./employeesViewResult.json

### GetEmployeeByIdAsync - получение сотрудника
GET {{baseUrl}}/{{employee02Id}}

?? status == 200

>> ./employeesViewResult.json
