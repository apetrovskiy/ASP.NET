@baseUrl = http://localhost:5000/api/v1/employees
# @import ./variables.http

@employeeToDeleteId = a3eeb793-e05b-4d08-a8ce-ed9408c22a9d
@adminRoleId = 00000000-0000-0000-0000-000000000000

################################################## DELETE AN EMPLOYEE ##################################################

################################################## Создание сотрудника ##################################################
### CreateEmployeeAsync
POST {{baseUrl}}
Accept: application/json
Content-Type: application/json

{
  "firstName": "string",
  "lastName": "string",
  "email": "string",
  "roles": [
    {
      "id": {{adminRoleId}},
      "name": "string",
      "description": "string"
    }
  ],
  "appliedPromocodesCount": 0
}

################################################## Удаление сотрудника ##################################################
### DeleteEmployeeByIdAsync
DELETE {{baseUrl}}/{{employeeToDeleteId}}
Accept: application/json

################################################## Получение сотрудника ##################################################
### GetEmployeeByIdAsync
GET {{baseUrl}}/{{employeeToDeleteId}}
Accept: application/json
