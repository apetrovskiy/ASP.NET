@baseUrl = http://localhost:5000/api/v1/employees
# @import ./variables.http

### CreateEmployeeAsync - создание сотрудника
# @name created
POST {{baseUrl}}
Accept: application/json
Content-Type: application/json

{
  "firstName": "First{{$randomInt 100 999}}",
  "lastName": "Last{{$randomInt 100 999}}",
  "email": "user{{$randomInt 100 999}}@yandex.ru",
  "roles" : [
    {
      "name": "Admin"
    }
  ],
  "appliedPromocodesCount": {{$randomInt 0 100}}
}

?? status == 201

>>! ./employeeCreationAndDeletionResult.json

### GetEmployeeByIdAsync - получение сотрудника
GET {{baseUrl}}/{{created.id}}
Accept: application/json

?? status == 200

>> ./employeeCreationAndDeletionResult.json

### DeleteEmployeeByIdAsync - удаление сотрудника
DELETE {{baseUrl}}/{{created.id}}
Accept: application/json

?? status == 204

>> ./employeeCreationAndDeletionResult.json

### GetEmployeeByIdAsync - получение сотрудника
GET {{baseUrl}}/{{created.id}}
Accept: application/json

?? status == 404

>> ./employeeCreationAndDeletionResult.json
