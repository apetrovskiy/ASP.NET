@baseUrl = http://localhost:5000/api/v1/employees
# @import ./variables.http

@newEmployeeID = "451876d5-c8e7-4a11-9c7b-eb9a54e1a32f"

################################################## CREATE AN EMPLOYEE ##################################################

################################################## Создание сотрудника ##################################################
### CreateEmployeeAsync
POST {{baseUrl}}
Content-Type: application/json

{
  "id": {{newEmployeeID}},
  "fullName": "string",
  "email": "string",
  "roles": [
    {
      "id": "string",
      "name": "string",
      "description": "string"
    }
  ],
  "appliedPromocodesCount": 0
}

################################################## Получение сотрудника ##################################################
### GetEmployeeByIdAsync
GET {{baseUrl}}/{{newEmployeeID}}
Accept: application/json
